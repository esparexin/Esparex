{
  "policy_metadata": {
    "policy_version": "3.0",
    "effective_date": "2026-07-13",
    "breaking_change": false,
    "deprecated": false
  },
  "workspaces": {
    "@esparex/design-tokens": {
      "path": "packages/design-tokens/**",
      "owner": "design-system",
      "dependents": [
        "@esparex/ui",
        "@esparex/mobile-ui",
        "@esparex/apps-web",
        "@esparex/apps-admin",
        "@esparex/apps-mobile"
      ]
    },
    "@esparex/contracts": {
      "path": "packages/contracts/**",
      "owner": "platform",
      "dependents": [
        "@esparex/shared",
        "@esparex/core",
        "@esparex/backend-api",
        "@esparex/apps-web",
        "@esparex/apps-admin",
        "@esparex/apps-mobile"
      ]
    },
    "@esparex/shared": {
      "path": "shared/**",
      "owner": "platform",
      "dependents": [
        "@esparex/core",
        "@esparex/backend-api",
        "@esparex/apps-web",
        "@esparex/apps-admin",
        "@esparex/apps-mobile"
      ]
    },
    "@esparex/ui": {
      "path": "packages/ui/**",
      "owner": "frontend",
      "dependents": [
        "@esparex/apps-web",
        "@esparex/apps-admin"
      ]
    },
    "@esparex/mobile-ui": {
      "path": "packages/mobile-ui/**",
      "owner": "mobile",
      "dependents": [
        "@esparex/apps-mobile"
      ]
    },
    "@esparex/core": {
      "path": "core/**",
      "owner": "platform",
      "dependents": [
        "@esparex/backend-api"
      ]
    },
    "@esparex/backend-api": {
      "path": "backend/api/**",
      "owner": "backend",
      "dependents": []
    },
    "@esparex/apps-web": {
      "path": "apps/web/**",
      "owner": "frontend",
      "dependents": []
    },
    "@esparex/apps-admin": {
      "path": "apps/admin/**",
      "owner": "frontend",
      "dependents": []
    },
    "@esparex/apps-mobile": {
      "path": "apps/mobile/**",
      "owner": "mobile",
      "dependents": []
    }
  },
  "verification_profiles": {
    "documentation": {
      "gates": [
        "markdown_lint",
        "link_validation"
      ]
    },
    "governance": {
      "extends": "documentation",
      "gates": [
        "governance_validation"
      ]
    },
    "shared": {
      "extends": "governance",
      "gates": [
        "build",
        "typecheck"
      ]
    },
    "backend": {
      "extends": "shared",
      "gates": [
        "eslint",
        "unit_test"
      ]
    },
    "frontend": {
      "extends": "shared",
      "gates": [
        "eslint",
        "next_build"
      ]
    },
    "release": {
      "extends": "backend",
      "gates": [
        "integration_test",
        "security_scan",
        "e2e_test"
      ]
    }
  },
  "risk_factors": {
    "critical_paths": [
      {
        "pattern": "**/payment**",
        "added_risk": "high",
        "reason": "Payment Processing module"
      },
      {
        "pattern": "**/auth**",
        "added_risk": "high",
        "reason": "Authentication/Authorization core"
      },
      {
        "pattern": "**/migration/**",
        "added_risk": "high",
        "reason": "Database Schema Migrations"
      },
      {
        "pattern": "core/src/shared-kernel/**",
        "added_risk": "medium",
        "reason": "Shared Kernel core primitives"
      }
    ],
    "file_type_overrides": [
      {
        "extension": ".md",
        "forced_risk": "trivial"
      },
      {
        "extension": ".txt",
        "forced_risk": "trivial"
      }
    ]
  },
  "change_rules": [
    {
      "trigger": "documentation",
      "condition": "only (*.md, *.txt)",
      "resolved_risk": "trivial",
      "profile": "documentation"
    },
    {
      "trigger": ".agents/governance/**, .agents/workflow/**",
      "condition": "only markdown/json/yaml",
      "resolved_risk": "low",
      "profile": "governance"
    },
    {
      "workspace_target": "@esparex/shared",
      "default_risk": "medium",
      "profile": "shared"
    },
    {
      "workspace_target": "@esparex/core",
      "default_risk": "medium",
      "profile": "backend"
    },
    {
      "workspace_target": "web",
      "default_risk": "medium",
      "profile": "frontend"
    },
    {
      "workspace_target": "admin",
      "default_risk": "medium",
      "profile": "frontend"
    }
  ],
  "output_specification": {
    "schema_version": "1.0",
    "format": "json",
    "required_fields": [
      "workspace",
      "risk",
      "checks",
      "status"
    ]
  },
  "verification_matrix": {
    "description": "Change-aware regression rows resolved by touched surface. Referenced by AI_WORKFLOW Phase 16. Rows are required as PASS or SKIP(reason); screenshot-only is never sufficient.",
    "surfaces": {
      "overlay_auth": {
        "when": "touches AuthModal, AuthModalContext, BottomSheetManager, Sheet/Dialog, useVisualViewport, login/OTP steps, or lib/api/client auth paths",
        "rows": ["open", "close", "desktop_width", "mobile_width", "keyboard_open", "keyboard_close", "focus", "escape_back", "home_scrolling", "listing_card_click", "auth_state", "otp_send", "otp_verify", "otp_resend_cooldown", "badges", "header", "navigation", "provider_ordering"]
      },
      "listing_card": {
        "when": "touches ad-card/**, listingPresentation, StatusChip/Badge tokens",
        "rows": ["card_click_navigation", "badge_domains", "overlay_badges", "condition_badges", "home_scrolling"]
      },
      "api_retry": {
        "when": "touches lib/api/client or auth send/verify/cancel paths",
        "rows": ["otp_send", "otp_verify", "resend_cooldown", "transient_retry_semantics"]
      }
    }
  },
  "scope_contract": {
    "description": "Compact machine-checkable scope/ownership record. Recorded in the Decision Log and PR body using existing evidence fields. No new reporting framework.",
    "required_fields": ["request", "declaredFiles", "highRiskTouched", "ownershipEvidence", "blastRadius", "actualDiff", "newOwners", "scopeExceeded", "regressions", "tests", "typecheck", "gates"],
    "blast_radius_dimensions": ["desktop", "mobile", "keyboard", "focus", "scroll", "authentication", "api_retry", "navigation", "tokens", "unrelated_consumers", "second_owner_risk"],
    "override_fields": ["why_this_owner", "why_existing_insufficient", "consumers_checked", "blast_radius", "regression_coverage"]
  }
}
