{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Governance Release Manifest Schema",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "release": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "waivers": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["version", "release", "evidence", "waivers"]
}
