    "expo-status-bar": "~2.0.0",
    "nativewind": "^4.0.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typescript": "^5.3.3"
  },
