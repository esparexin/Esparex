{
  "name": "@esparex/apps-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node ../../scripts/kill-port.js 3000 && node ../../scripts/clean.js --web",
    "predev": "npm run clean",
    "dev": "cross-env NODE_OPTIONS=--disable-warning=DEP0169 next dev -p 3000",
    "prebuild": "npm run build -w @esparex/design-tokens",
    "build": "npm run build -w @esparex/design-tokens && cross-env SKIP_ENV_VALIDATION=true NEXT_DISABLE_WEBPACK_CACHE=1 next build --webpack",
    "analyze:routes": "node scripts/analyze-next-build.cjs",
    "analyze:build": "npm run build && npm run analyze:routes",
    "start": "cross-env NODE_OPTIONS=--disable-warning=DEP0169 next start -p 3000",
    "lint": "eslint .",
    "lint:image-domains": "node scripts/validate-image-domains.cjs",
    "ci:image-domains": "node scripts/validate-image-domains.cjs",
    "type-check": "tsc --noEmit",
    "seed:locations:full": "echo \"Moved to backend ops; run from backend package.\" && exit 1",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:listing-edit": "playwright test tests/edit-listing.spec.ts --project=chromium --workers=4",
    "e2e:listing-edit:ci": "playwright test tests/edit-listing.spec.ts --project=chromium --workers=1",
    "test:smoke": "playwright test tests/listing-chat-smoke.spec.ts",
    "guard:unused-imports": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0 --rule \"unused-imports/no-unused-imports:error\""
  },
  "dependencies": {
    "@esparex/contracts": "*",
    "@esparex/design-tokens": "*",
    "@esparex/shared": "*",
    "@esparex/ui": "*",
    "@hookform/resolvers": "^5.9.1",
    "@react-google-maps/api": "^2.20.7",
    "@sentry/nextjs": "^10.71.0",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-virtual": "^3.14.10",
    "axios": "^1.15.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "crypto-js": "^4.2.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.18.0",
    "framer-motion": "^13.1.1",
    "fuse.js": "^7.1.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.3",
    "socket.io-parser": "^4.2.6",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.2",
    "@playwright/test": "^1.57.0",
    "@types/crypto-js": "^4.2.2",
    "@types/google.maps": "^3.65.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.18",
    "dotenv": "^17.2.3",
    "eslint": "^10.9.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    ">0.3%",
    "not dead",
    "not op_mini all"
  ]
}
