# Esparex Mobile Environment Configuration (SSOT)
# Copy this file to .env or .env.local for local development.

# Development Toolchain Requirements:
# - Node.js: >= 22 (pinned in root package.json)
# - JDK (Java Development Kit): JDK 17 or JDK 21 (LTS)
#   Note: Do not use JDK 25+ as it is incompatible with the Gradle 8.10.2 settings plugin.
# - Gradle: 8.10.2 (managed via gradle-wrapper.properties)
# - Xcode: >= 15 (with command-line tools installed)

# Base Backend API Endpoint URL (Required)
EXPO_PUBLIC_API_URL=https://api.esparex.in/api
