{
  "expo": {
    "name": "Esparex",
    "slug": "esparex",
    "scheme": "esparex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0C0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.esparex.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Receive alerts for new messages and listing activity.",
        "NSCameraUsageDescription": "Esparex requires camera access to capture listing photos.",
        "NSPhotoLibraryUsageDescription": "Esparex requires photo library access to upload listing images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0C0B"
      },
      "package": "com.esparex.mobile",
      "versionCode": 1,
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A0C0B",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Esparex requires photo library access to upload listing images.",
          "cameraPermission": "Esparex requires camera access to capture listing photos.",
          "requestMicrophonePermissionsIOS": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e93d786f-2ab6-432c-bfd4-458e8191d31a"
      }
    }
  }
}
