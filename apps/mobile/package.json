{
  "name": "@esparex/apps-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "prebuild": "expo prebuild",
    "eas-build-post-install": "npm run build -w @esparex/design-tokens -w @esparex/contracts -w @esparex/shared",
    "test": "jest"
  },
  "dependencies": {
    "@esparex/contracts": "*",
    "@esparex/design-tokens": "*",
    "@esparex/mobile-ui": "*",
    "@esparex/shared": "*",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.9",
    "@tanstack/react-query": "^5.102.3",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "eslint-config-expo": "~57.0.1",
    "expo": "~57.0.16",
    "expo-asset": "~57.0.14",
    "expo-build-properties": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.13",
    "expo-notifications": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.0.1",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-css-interop": "0.2.6",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "~4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.6",
    "jest": "^30.4.2",
    "jest-expo": "~57.0.4",
    "prettier": "^3.3.3",
    "react-test-renderer": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    }
  }
}
