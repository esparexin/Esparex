{
  "name": "@esparex/apps-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "prebuild": "expo prebuild",
    "eas-build-post-install": "npm run build -w @esparex/design-tokens -w @esparex/contracts -w @esparex/shared",
    "test": "jest"
  },
  "dependencies": {
    "@esparex/contracts": "*",
    "@esparex/design-tokens": "*",
    "@esparex/mobile-ui": "*",
    "@esparex/shared": "*",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "eslint-config-expo": "~57.0.2",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.4",
    "expo-build-properties": "~0.13.3",
    "expo-crypto": "~14.0.2",
    "expo-device": "~7.0.3",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "nativewind": "^4.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-css-interop": "0.2.6",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    }
  }
}
