{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@esparex/contracts": [
        "../../packages/contracts/src"
      ],
      "@esparex/contracts/*": [
        "../../packages/contracts/src/v1/*"
      ],
      "@esparex/mobile-ui": [
        "../../packages/mobile-ui/src"
      ],
      "@esparex/mobile-ui/*": [
        "../../packages/mobile-ui/src/*"
      ],
      "@esparex/shared": [
        "../../shared/src"
      ],
      "@esparex/shared/*": [
        "../../shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
