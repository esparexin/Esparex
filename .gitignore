# -----------------------------------------------------------------------------
# Graphify — knowledge graph tooling
# -----------------------------------------------------------------------------
# Rule: NOTHING inside graphify-out/ is ever committed.
# The entire directory (graph, reports, cache, backups, obsidian vault, exports)
# is generated at runtime and must never appear in Git.

# Primary output directory (covers all subdirectories including YYYY-MM-DD backups)
graphify-out/

# Graphify internal state files (if created outside graphify-out/)
