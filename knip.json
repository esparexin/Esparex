{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "warn",
    "unlisted": "warn",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  },
  "ignoreDependencies": [
    "@radix-ui/*",
    "@react-google-maps/api",
    "@sentry/*",
    "@zodios/core",
    "cmdk",
    "embla-carousel-react",
    "file-type",
    "fuse.js",
    "heic2any",
    "input-otp",
    "next-themes",
    "papaparse",
    "react-day-picker",
    "react-resizable-panels",
    "recharts",
    "sharp",
    "socket.io-parser",
    "@aws-sdk/*",
    "@bull-board/*",
    "@socket.io/*",
    "@turf/*",
    "axios",
    "bcryptjs",
    "bullmq",
    "csv-parser",
    "firebase-admin",
    "jimp",
    "jsonwebtoken",
    "multer",
    "nodemailer",
    "qrcode",
    "razorpay",
    "sanitize-html",
    "socket.io",
    "uuid",
    "winston",
    "winston-daily-rotate-file",
    "speakeasy",
    "eslint",
    "typescript-eslint",
    "@next/eslint-plugin-next",
    "@types/*",
    "eslint-config-prettier",
    "eslint-plugin-unused-imports",
    "globals",
    "pm2",
    "dotenv",
    "mongoose",
    "mongodb",
    "date-fns",
    "postcss",
    "tailwindcss",
    "autoprefixer",
    "ts-node",
    "tsx",
    "jest",
    "vitest",
    "clsx",
    "tailwind-merge",
    "vaul",
    "@tanstack/react-virtual",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    // False positive: consumed in packages/ui/src/data-display/Badge.tsx
    "class-variance-authority",
    // False positives: used throughout apps/mobile/src — knip mis-attributes mobile workspace deps
    "expo-status-bar",
    "react-native-svg",
    "@esparex/design-tokens",
    "@esparex/shared",
    "expo-updates",
    "expo-system-ui",
    "expo-constants",
    "lucide-react-native",
    // False positives: devDeps used by Expo/Babel build toolchain, not directly imported
    "@babel/core",
    "@commitlint/cli",
    "husky"
  ],
  "workspaces": {
    "apps/admin": {
      "entry": ["src/app/**/page.tsx", "src/app/**/layout.tsx", "src/middleware.ts", "next.config.mjs", "tailwind.config.ts", "postcss.config.mjs"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/web": {
      "entry": ["src/app/**/page.tsx", "src/app/**/layout.tsx", "src/middleware.ts", "next.config.mjs", "tailwind.config.ts", "postcss.config.mjs"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mobile": {
      "entry": ["App.tsx", "index.js", "capacitor.config.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "backend/api": {
      "entry": ["src/index.ts", "src/cron/**/*.ts", "src/smoke.ts"],
      "project": ["src/**/*.ts"]
    },
    "core": {
      "entry": [
        "src/index.ts",
        "src/services/**/*.ts",
        "src/utils/**/*.ts",
        "src/domains/**/index.ts",
        "src/domains/**/ports/*.ts",
        "src/scripts/**/*.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.scratch/**",
    "**/.agents/**",
    "**/.venv/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/.eslintcache",
    "**/storybook-static/**",
    "**/public/build/**",
    "scripts/**",
    "eslint.config.mjs",
    "tooling/**",
    // backend/api/scripts use relative paths (../src/config/db) and are standalone migration runners
    "backend/api/scripts/**",
    // mobile-ui test files use describe/it without exports — not consumable modules
    "packages/mobile-ui/src/**/__tests__/**"
  ]
}
